# Connection string do Session pooler do Supabase (não mais um Postgres local):
# postgresql://postgres.<ref>:<senha>@aws-N-us-east-1.pooler.supabase.com:5432/postgres?sslmode=no-verify
# O `?sslmode=no-verify` é necessário: o certificado do pooler é assinado pela
# CA própria do Supabase, que não está no trust store do sistema — sem esse
# parâmetro a conexão fica sem TLS (nenhum sufixo) ou quebra com
# SELF_SIGNED_CERT_IN_CHAIN (`sslmode=require`). Detalhes:
# https://supabase.com/docs/guides/database/connecting-to-postgres
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# App OAuth na Twitch Developer Console. A redirect URI cadastrada lá precisa
# bater exatamente com <BETTER_AUTH_URL>/api/auth/callback/twitch.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- E-mail transacional (lib/email) ---
# Sem RESEND_API_KEY o e-mail é impresso no console (dev). Em produção é obrigatória.
RESEND_API_KEY=
EMAIL_FROM="VLR Fantasy <nao-responda@seudominio.com>"

# --- Pipeline de dados do vlr.gg (lib/vlr) ---
# Obrigatória: entra no User-Agent para o vlr.gg saber com quem falar.
VLR_CONTACT_EMAIL=
VLR_BASE_URL=https://www.vlr.gg
# Nunca falsificar navegador — o default já é `VlrFantasy/1.0 (+<email>)`.
# Deixe a linha de fora (não `VLR_USER_AGENT=` vazia): o schema
# (`lib/vlr/config.ts`) usa `z.string().min(1).optional()`, que aceita a
# variável ausente mas rejeita string vazia — `VLR_USER_AGENT=` quebra a
# validação em vez de cair no default.
# Intervalo mínimo entre requisições, em ms.
VLR_RATE_LIMIT_MS=1100
VLR_REQUEST_TIMEOUT_MS=15000
# Onde o HTML bruto é gravado antes de qualquer parse.
VLR_STORAGE_DIR=storage/raw
# Fuso em que o vlr.gg renderiza `data-utc-ts` (que não é UTC).
VLR_SOURCE_TZ=America/New_York
