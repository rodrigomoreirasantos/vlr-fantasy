DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# App OAuth na Twitch Developer Console. A redirect URI cadastrada lá precisa
# bater exatamente com <BETTER_AUTH_URL>/api/auth/callback/twitch.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- E-mail transacional (lib/email) ---
# Sem RESEND_API_KEY o e-mail é impresso no console (dev). Em produção é obrigatória.
RESEND_API_KEY=
EMAIL_FROM="VLR Fantasy <nao-responda@seudominio.com>"

# --- Pipeline de dados do vlr.gg (lib/vlr) ---
# Obrigatória: entra no User-Agent para o vlr.gg saber com quem falar.
VLR_CONTACT_EMAIL=
VLR_BASE_URL=https://www.vlr.gg
# Nunca falsificar navegador — o default já é `VlrFantasy/1.0 (+<email>)`.
VLR_USER_AGENT=
# Intervalo mínimo entre requisições, em ms.
VLR_RATE_LIMIT_MS=1100
VLR_REQUEST_TIMEOUT_MS=15000
# Onde o HTML bruto é gravado antes de qualquer parse.
VLR_STORAGE_DIR=storage/raw
# Fuso em que o vlr.gg renderiza `data-utc-ts` (que não é UTC).
VLR_SOURCE_TZ=America/New_York
